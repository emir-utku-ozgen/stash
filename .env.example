# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# LLM: set ONE of these. Gemini has a free tier (aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional, paid: used only when GEMINI_API_KEY is empty
ANTHROPIC_API_KEY=

# Walrus Memory playground (memory.walrus.xyz): account ID and delegate private key
MEMWAL_ACCOUNT_ID=
MEMWAL_KEY=
# Optional, defaults to the public mainnet relayer
# MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz

# Tatum dashboard (dashboard.tatum.io) -> API key
TATUM_API_KEY=
